// wrangler.deploy.template.jsonc - COMMITTED placeholder template for CI CF deploy.
// scripts/deploy_cf.py --from-template renders this into the gitignored
// wrangler.deploy.jsonc by substituting the placeholder tokens below from the
// environment (CI provides them from GitHub Actions secrets synced from skret).
// Real account/KV/D1/Vectorize IDs never live in git; they are placeholders here.
// NO routes block (wet.n24q02m.com already attached; the deploy token can't
// reconcile routes). workers_dev:false keeps the worker off *.workers.dev.
{
  "name": "wet-mcp-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "containers": [
    {
      "name": "wet-mcp-worker",
      "class_name": "WetContainer",
      "image": "registry.cloudflare.com/${CLOUDFLARE_ACCOUNT_ID}/wet-mcp:${IMAGE_TAG}",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "WET", "class_name": "WetContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WetContainer"] }],
  "kv_namespaces": [{ "binding": "KV", "id": "${CF_KV_ID}" }],
  "d1_databases": [
    { "binding": "D1", "database_name": "wet-docs", "database_id": "${CF_D1_ID}", "migrations_dir": "migrations" }
  ],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "${CF_VECTORIZE_ID}" }],
  "vars": {
    "DISABLE_LOCAL_SEARCH": "true",
    "BROWSERLESS_URL": "https://browserless.n24q02m.com",
    "DISABLE_LOCAL_BROWSER": "true",
    "DISABLE_LOCAL_EMBED": "true",
    // Paired with the line above: the SLIM image uninstalls qwen3-embed, so the
    // local leg is absent for rerank too. See wrangler.jsonc for why the
    // deploy-level RERANK_MODELS does not cover the per-sub case.
    "DISABLE_LOCAL_RERANK": "true",
    "BROWSER_BACKENDS": "browserless,cf-browser-rendering",
    "CF_ACCOUNT_ID": "${CLOUDFLARE_ACCOUNT_ID}",
    "PUBLIC_URL": "${PUBLIC_URL}",
    "MCP_STORAGE_BACKEND": "cf-kv",
    "MCP_KV_BASE_URL": "http://kv.internal",
    "DOCS_DB_BACKEND": "cf-d1",
    "MCP_D1_BASE_URL": "http://d1.internal",
    "MCP_VECTORIZE_BASE_URL": "http://vectorize.internal",
    "MCP_VECTORIZE_IDX": "${CF_VECTORIZE_ID}",
    "EMBEDDING_MODELS": "jina_ai/jina-embeddings-v5-text-small",
    "RERANK_MODELS": "jina_ai/jina-reranker-v3",
    "LLM_MODELS": "openrouter/minimax/minimax-m3",
    "SEARCH_BACKEND": "searxng",
    "WET_AUTO_SEARXNG": "false"
  },
  "observability": { "enabled": true }
}
