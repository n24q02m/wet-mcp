                            WHERE url = ? AND version_id = ? AND chunk_index IN ({_placeholders})""",
                        [_url, _ver] + _chunk_indices,
                    ).fetchall()
                    for r in rows:
                        _adj_map[(r["url"], r["version_id"], r["chunk_index"])] = r[
