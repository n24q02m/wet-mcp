        fts_chunks: dict[str, dict],
        adj_map: dict[tuple[str, str, int], str],
        limit: int,
    ) -> list[dict]:
        """Format final search results with diversity limits and context."""
        max_per_url = 2
        url_counts: dict[str, int] = {}
        results = []

